<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.resume.marketplace.mapper.FavoriteMapper">

    <resultMap id="FavoriteResultMap" type="com.resume.marketplace.entity.Favorite">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="productId" column="product_id"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.resume.marketplace.entity.Favorite"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO favorite (user_id, product_id)
        VALUES (#{userId}, #{productId})
    </insert>

    <select id="findByUserAndProduct" resultMap="FavoriteResultMap">
        SELECT id, user_id, product_id, created_at
        FROM favorite
        WHERE user_id = #{userId} AND product_id = #{productId}
    </select>

    <delete id="delete">
        DELETE FROM favorite
        WHERE user_id = #{userId} AND product_id = #{productId}
    </delete>

    <select id="findByUser" resultMap="FavoriteResultMap">
        SELECT id, user_id, product_id, created_at
        FROM favorite
        WHERE user_id = #{userId}
        ORDER BY created_at DESC
    </select>

</mapper>